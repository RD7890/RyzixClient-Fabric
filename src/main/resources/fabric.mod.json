	"authors": [
		"Ryzix"
	],
	"contact": {
		"sources": "https://github.com/Ryzix-Client/RyzixClient-Fabric"
	},
	"license": "CC0-1.0",
	"icon": "assets/ryzixclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.ryzix.client.RyzixClient"
		],
		"client": [
			"com.ryzix.client.RyzixClientInit"
		]
	},
	"depends": {
		"fabricloader": ">=0.15.11",
